{
  "name": "@jam-comments/remix",
  "version": "3.0.0",
  "description": "A library for integrating JamComments into a Remix application.",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "scripts": {
    "prepare": "npm run build",
    "build": "rm -rf dist && npm run build:cjs",
    "build:cjs": "tsc --module commonjs --outDir ./dist/cjs",
    "format": "prettier --write src"
  },
  "files": [
    "./src",
    "./dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/cjs/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    },
    "./server": {
      "import": "./dist/cjs/server.js",
      "require": "./dist/cjs/server.js",
      "types": "./dist/cjs/server.d.ts"
    }
  },
  "keywords": [],
  "author": "Alex MacArthur",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "dependencies": {
    "@jam-comments/server-utilities": "^6.0.0"
  }
}
