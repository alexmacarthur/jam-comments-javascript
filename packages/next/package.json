{
  "name": "@jam-comments/next",
  "version": "6.0.1",
  "description": "A library for integrating JamComments into a Next.js application.",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/esm/index.d.ts"
    },
    "./server": {
      "import": "./dist/esm/server.js",
      "types": "./dist/esm/server.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && npm run build:esm",
    "build:esm": "tsc --module es2020 --outDir dist/esm",
    "prepare": "npm run build",
    "format": "prettier --write src"
  },
  "files": [
    "./src",
    "./dist"
  ],
  "keywords": [],
  "author": "Alex MacArthur",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "2b1cefb90c89a2f70099213881b09216f20e3dc2",
  "dependencies": {
    "@jam-comments/server-utilities": "^6.0.0",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
